---
import BookLayout from '../../../../layouts/BookLayout.astro';
import { render } from 'astro:content';
import { getLocalizedBooks } from '../../../../lib/bookContent';

export async function getStaticPaths() {
  const books = await getLocalizedBooks('en');

  return books.flatMap(({ book, bookSlug, chapters }) => {
    const chapterMeta = chapters.map(chapter => ({
      slug: chapter.slug,
      title: chapter.title,
      order: chapter.order,
    }));

    return chapters.map(chapter => ({
      params: { book: bookSlug, chapter: chapter.slug },
      props: {
        bookSlug,
        bookTitle: book.data.title,
        chapterEntry: chapter.entry,
        chapterSlug: chapter.slug,
        chapters: chapterMeta,
      },
    }));
  });
}

const { bookSlug, bookTitle, chapterEntry, chapterSlug, chapters } = Astro.props;
const { Content } = await render(chapterEntry);
---

<BookLayout
  bookSlug={bookSlug}
  bookTitle={bookTitle}
  chapterTitle={chapterEntry.data.title}
  description={chapterEntry.data.description}
  chapters={chapters}
  currentSlug={chapterSlug}
  lang="en"
>
  <Content />
</BookLayout>
