---
const history = [
  {
    period: '2026年7月12日',
    title: '関数型まつり2026 登壇「壊れたパーサからはじめる関数型設計と構成的なパーサ」',
    desc: 'ナイーブなパーサ実装を出発点に、状態管理・エラー処理・合成という異なる関心を分離し、モナドやApplicativeといった抽象を用いて再構成する過程を発表しました。登壇の経緯はTechTrainのインタビュー記事でも紹介されています。',
    type: 'talk',
    links: [
      { label: 'スライド', url: 'https://speakerdeck.com/raiga0310/huai-retapasakarashi-meruguan-shu-xing-she-ji-togou-cheng-de-napasa' },
      { label: 'プロポーザル', url: 'https://fortee.jp/2026fp-matsuri/proposal/8e81ee8e-df0e-4fa5-9cbc-f4fb797b81cb' },
      { label: 'インタビュー記事', url: 'https://techtrain.dev/media/articles/vy10jfnnk91u' },
    ],
  },
  {
    period: '2025年8月〜2025年9月',
    title: 'Sansan株式会社 サマーインターン',
    desc: '技術本部 Data Intelligence EU MasterData グループにてインターン',
    type: 'intern',
  },
  {
    period: '2023年10月〜',
    title: '株式会社PR TIMES 開発本部 長期インターン',
    desc: 'PHPによるバックエンド開発。PHPStan・PHPUnit・BigQuery等を活用',
    type: 'intern',
  },
  {
    period: '2023年4月〜',
    title: '名古屋工業大学 第一部情報工学科 知能情報分野',
    desc: '',
    type: 'academic',
  },
  {
    period: '2018年4月〜2023年3月',
    title: '豊田工業高等専門学校 情報工学科',
    desc: '寮生会班長（3年）、学生会執行部副会長（3・4年）',
    type: 'academic',
  },
  {
    period: '2003年3月10日',
    title: '生まれる',
    desc: '愛知県出身',
    type: 'life',
  },
];
---

<section class="section bg-alt" id="history">
  <div class="container">
    <h2 class="section-title">History</h2>
    <div class="timeline__legend">
      <span class="legend-item legend-item--talk">登壇・執筆</span>
      <span class="legend-item legend-item--intern">インターン</span>
      <span class="legend-item legend-item--academic">学業</span>
      <span class="legend-item legend-item--life">生活</span>
    </div>
    <ol class="timeline">
      {history.map((item) => (
        <li class="timeline__item">
          <div class={`timeline__dot timeline__dot--${item.type}`} aria-hidden="true"></div>
          <div class="timeline__content">
            <span class="timeline__period">{item.period}</span>
            <h3 class="timeline__title">{item.title}</h3>
            {item.desc && <p class="timeline__desc">{item.desc}</p>}
            {item.links && item.links.length > 0 && (
              <p class="timeline__links">
                {item.links.map((link, i) => (
                  <>
                    {i > 0 && <span class="timeline__link-sep" aria-hidden="true">/</span>}
                    <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
                  </>
                ))}
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .bg-alt {
    background: var(--surface);
  }

  .timeline__legend {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .legend-item::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .legend-item--talk::before { background: #3b82f6; }
  .legend-item--intern::before { background: #f59e0b; }
  .legend-item--academic::before { background: var(--accent); }
  .legend-item--life::before { background: #a78bfa; }

  .timeline {
    list-style: none;
    position: relative;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.66rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--border);
  }

  .timeline__item {
    position: relative;
    padding-bottom: 2.5rem;
  }

  .timeline__item:last-child {
    padding-bottom: 0;
  }

  .timeline__dot {
    position: absolute;
    left: -1.55rem;
    top: 0.45rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .timeline__dot--talk     { background: #3b82f6; }
  .timeline__dot--intern   { background: #f59e0b; }
  .timeline__dot--academic { background: var(--accent); }
  .timeline__dot--life     { background: #a78bfa; }

  .timeline__period {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .timeline__title {
    font-size: 1.05rem;
    margin: 0.25rem 0 0.4rem;
  }

  .timeline__desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .timeline__links {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
  }

  .timeline__link-sep {
    margin: 0 0.4rem;
    color: var(--text-muted);
  }
</style>