---
interface Props {
  pdf: string;
  title?: string;
  locale?: 'ja' | 'en';
}

const { pdf, title = 'Slides', locale = 'ja' } = Astro.props;
const openLabel = locale === 'en' ? 'Open the PDF in a new tab' : 'PDF を新しいタブで開く';
const downloadLabel = locale === 'en' ? 'Download PDF' : 'PDF をダウンロード';
const noteLabel = locale === 'en'
  ? 'If the embedded preview does not load in your browser, use one of the links below.'
  : '埋め込みプレビューが表示されない場合は、下のリンクから開いてください。';
---

<div class="viewer">
  <div class="viewer__frame-wrap">
    <iframe
      src={pdf}
      title={`${title} PDF`}
      class="viewer__frame"
      loading="lazy"
      referrerpolicy="no-referrer"
    ></iframe>
  </div>
  <div class="viewer__actions">
    <a href={pdf} target="_blank" rel="noopener noreferrer" class="viewer__link">
      {openLabel}
    </a>
    <a href={pdf} download class="viewer__link viewer__link--secondary">
      {downloadLabel}
    </a>
  </div>
  <p class="viewer__note">{noteLabel}</p>
</div>

<style>
  .viewer {
    background: var(--slides-bg, #1a1a2e);
    border-radius: 8px;
    overflow: hidden;
    max-width: 900px;
    margin: 0 auto;
  }

  .viewer__frame-wrap {
    width: 100%;
    background: #000;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 480px;
  }

  .viewer__frame {
    display: block;
    width: 100%;
    min-height: 70vh;
    border: 0;
    background: #111;
  }

  .viewer__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 0.75rem 1rem;
    background: var(--slides-surface, #232340);
    border-top: 1px solid var(--slides-border, #333366);
  }

  .viewer__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--slides-border, #333366);
    color: var(--slides-text, #e0e0e0);
    border-radius: 4px;
    padding: 0.45rem 0.9rem;
    text-decoration: none;
    font-size: 0.875rem;
    transition: background 0.15s, border-color 0.15s;
  }

  .viewer__link:hover {
    border-color: var(--slides-accent, #7c8cf5);
    color: var(--slides-accent, #7c8cf5);
    text-decoration: none;
  }

  .viewer__link--secondary {
    color: var(--slides-muted, #a7adc5);
  }

  .viewer__note {
    margin: 0;
    padding: 0.85rem 1rem 1rem;
    text-align: center;
    color: var(--slides-muted, #888);
    font-size: 0.8rem;
    background: var(--slides-surface, #232340);
  }
</style>
