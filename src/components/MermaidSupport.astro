<script type="module" is:inline>
  const MERMAID_SELECTOR = '.mermaid, pre[data-language="mermaid"]';
  const WIDE_DIAGRAM_THRESHOLD = 1.1;
  let mermaidLoader;

  function getMermaidTheme() {
    return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'default';
  }

  function getMermaid() {
    if (!mermaidLoader) {
      mermaidLoader = import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')
        .then((mod) => mod.default);
    }
    return mermaidLoader;
  }

  function normalizeMermaidNode(node) {
    if (!(node instanceof HTMLElement)) {
      return null;
    }

    if (node.matches('.mermaid')) {
      return node;
    }

    if (node.matches('pre[data-language="mermaid"]')) {
      const replacement = document.createElement('div');
      replacement.className = 'mermaid';
      replacement.textContent = (node.textContent ?? '').trim();
      node.replaceWith(replacement);
      return replacement;
    }

    return null;
  }

  function getIntrinsicSvgWidth(svg) {
    const viewBox = svg.viewBox?.baseVal;
    if (viewBox && Number.isFinite(viewBox.width) && viewBox.width > 0) {
      return viewBox.width;
    }

    const width = Number.parseFloat(svg.getAttribute('width') ?? '');
    if (Number.isFinite(width) && width > 0) {
      return width;
    }

    return null;
  }

  function applyMermaidLayout(node) {
    const svg = node.querySelector('svg');
    if (!(svg instanceof SVGSVGElement)) {
      node.dataset.mermaidLayout = 'fit';
      return;
    }

    const intrinsicWidth = getIntrinsicSvgWidth(svg);
    const availableWidth = node.clientWidth;
    const isWide = intrinsicWidth != null
      && availableWidth > 0
      && intrinsicWidth > availableWidth * WIDE_DIAGRAM_THRESHOLD;

    if (isWide) {
      node.dataset.mermaidLayout = 'wide';
      svg.style.width = `${intrinsicWidth}px`;
      svg.style.maxWidth = 'none';
      svg.style.height = 'auto';
      return;
    }

    node.dataset.mermaidLayout = 'fit';
    svg.style.removeProperty('width');
    svg.style.maxWidth = '100%';
    svg.style.height = 'auto';
  }

  async function renderMermaid() {
    const nodes = Array.from(document.querySelectorAll(MERMAID_SELECTOR))
      .map(normalizeMermaidNode)
      .filter((node) => node instanceof HTMLElement);
    if (!nodes.length) {
      return;
    }

    for (const node of nodes) {
      if (!node.dataset.mermaidSource) {
        node.dataset.mermaidSource = (node.textContent ?? '').trim();
      }
      node.removeAttribute('data-processed');
      node.textContent = node.dataset.mermaidSource ?? '';
    }

    const mermaid = await getMermaid();
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'loose',
      theme: getMermaidTheme(),
    });
    await mermaid.run({ nodes });

    for (const node of nodes) {
      applyMermaidLayout(node);
    }
  }

  function scheduleRender() {
    void renderMermaid().catch((error) => {
      console.error('Failed to render Mermaid diagrams.', error);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleRender, { once: true });
  } else {
    scheduleRender();
  }

  new MutationObserver((mutations) => {
    if (mutations.some((mutation) => mutation.attributeName === 'data-theme')) {
      scheduleRender();
    }
  }).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>

<style is:global>
  .mermaid {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    overflow-x: auto;
  }

  .mermaid svg {
    display: block;
    height: auto;
    margin: 0 auto;
  }

  .mermaid[data-mermaid-layout="fit"] svg {
    max-width: 100%;
  }

  .mermaid[data-mermaid-layout="wide"] svg {
    margin: 0;
  }
</style>
